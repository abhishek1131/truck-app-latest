<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restock Alert - TruXtoK</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f4f4f4;
        }
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #28a745;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header h1 {
            color: #28a745;
            margin: 0;
            font-size: 28px;
        }
        .alert-badge {
            background-color: #28a745;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            display: inline-block;
            margin-top: 10px;
        }
        .summary {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 25px;
        }
        .summary h3 {
            margin-top: 0;
            color: #155724;
        }
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }
        .items-table th,
        .items-table td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }
        .items-table th {
            background-color: #f8f9fa;
            font-weight: bold;
            color: #495057;
        }
        .items-table tr:nth-child(even) {
            background-color: #f8f9fa;
        }
        .restock-item {
            background-color: #fff3cd !important;
            color: #856404;
        }
        .high-priority {
            background-color: #f8d7da !important;
            color: #721c24;
            font-weight: bold;
        }
        .footer {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
        .action-button {
            display: inline-block;
            background-color: #28a745;
            color: white;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
            margin: 10px 5px;
            font-weight: bold;
        }
        .action-button:hover {
            background-color: #218838;
        }
        .priority-high {
            color: #dc3545;
            font-weight: bold;
        }
        .priority-medium {
            color: #fd7e14;
            font-weight: bold;
        }
        .priority-low {
            color: #ffc107;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📦 Restock Alert</h1>
            <div class="alert-badge">RESTOCK REQUIRED</div>
        </div>

        <div class="summary">
            <h3>📊 Restock Summary</h3>
            <p><strong>Total Items Needing Restock:</strong> <%= restockItems.length %></p>
            <p><strong>High Priority Items:</strong> <%= restockItems.filter(item => item.priority === 'high').length %></p>
            <p><strong>Alert Date:</strong> <%= new Date().toLocaleDateString('en-US', { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }) %></p>
        </div>

        <h3>📦 Items Requiring Restocking</h3>
        <table class="items-table">
            <thead>
                <tr>
                    <th>Item Name</th>
                    <th>Part Number</th>
                    <th>Category</th>
                    <th>Current Stock</th>
                    <th>Standard Level</th>
                    <th>Suggested Qty</th>
                    <th>Priority</th>
                    <th>Location</th>
                </tr>
            </thead>
            <tbody>
                <% restockItems.forEach(function(item) { %>
                <tr class="<%= item.priority === 'high' ? 'high-priority' : 'restock-item' %>">
                    <td><strong><%= item.name %></strong></td>
                    <td><%= item.partNumber %></td>
                    <td><%= item.category || 'Uncategorized' %></td>
                    <td><%= item.currentQuantity %></td>
                    <td><%= item.standardLevel %></td>
                    <td><%= item.suggestedQuantity %></td>
                    <td>
                        <% if (item.priority === 'high') { %>
                            <span class="priority-high">HIGH</span>
                        <% } else if (item.priority === 'medium') { %>
                            <span class="priority-medium">MEDIUM</span>
                        <% } else { %>
                            <span class="priority-low">LOW</span>
                        <% } %>
                    </td>
                    <td><%= item.location || 'N/A' %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <div style="margin-top: 25px;">
            <h3>🎯 Recommended Actions</h3>
            <ul>
                <li><strong>Immediate:</strong> Restock high priority items first</li>
                <li><strong>Planning:</strong> Order suggested quantities for each item</li>
                <li><strong>Review:</strong> Check supplier availability and lead times</li>
                <li><strong>Update:</strong> Adjust standard levels if needed</li>
            </ul>
        </div>

        <div style="text-align: center; margin: 25px 0;">
            <a href="#" class="action-button">📋 View Full Inventory</a>
            <a href="#" class="action-button">🛒 Create Restock Order</a>
        </div>

        <div class="footer">
            <p><strong>TruXtoK Inventory Management System</strong></p>
            <p>This is an automated alert. Please do not reply to this email.</p>
            <p>For support, contact: <a href="mailto:support@truxtok.com">support@truxtok.com</a></p>
        </div>
    </div>
</body>
</html>
